# Copy to .env.local for local development. Nothing here is required to run.

# Placeholder admin gate. When set, /admin asks for this passphrase once and
# API mutations require it (cookie session, `x-admin-token`, or Bearer).
# Leave unset to keep admin open (a notice is shown in the UI).
ADMIN_GATE=

# Absolute path for the JSON catalog. Defaults to ./data/catalog.json
# (or /tmp/marketing-request-forms/catalog.json on Vercel).
# CATALOG_PATH=
